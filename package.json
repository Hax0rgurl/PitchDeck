{
  "name": "pitchdeck-local",
  "version": "0.2.0",
  "description": "Local-first macOS movie pitch deck and storyboard production app.",
  "author": "Hax0rgurl",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node server/index.js",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "check": "node --check server/index.js && node --check electron/main.js && npm test && vite build",
    "desktop": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "package:release": "./script/package_release.sh"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.561.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.abandonedmuse.pitchdeck",
    "productName": "PITCHDECK",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*",
      "!data/**/*",
      "!models/**/*",
      "!release/**/*",
      "!node_modules/.cache/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "resources/PITCHDECK.icns",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  }
}
